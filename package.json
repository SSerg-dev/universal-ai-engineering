{
  "name": "universal-agentic-os-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "uaos": "./dist/src/adapters/inbound/cli.js"
  },
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "test": "vitest run",
    "test:database": "node scripts/test-database.mjs",
    "build": "tsc",
    "uaos": "node ./dist/src/adapters/inbound/cli.js",
    "ingest": "node ./dist/src/composition/ingest-fixtures.js",
    "validate": "npm run typecheck && npm run typecheck:core && npm test && npm run build",
    "build:ui": "npm --prefix ui run build",
    "test:ui": "npm --prefix ui run test",
    "test:browser": "node scripts/test-database.mjs --browser",
    "validate:all": "npm run validate && npm --prefix ui run validate"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "fastify": "5.12.8",
    "mammoth": "1.13.0",
    "pg": "8.23.1",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
