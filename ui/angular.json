{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "inspector": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/inspector",
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": []
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "sourceMap": false,
              "optimization": { "scripts": true, "styles": true, "fonts": false },
              "budgets": [{ "type": "initial", "maximumWarning": "750kB", "maximumError": "1MB" }]
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "proxy.conf.json" },
          "configurations": {
            "production": { "buildTarget": "inspector:build:production" },
            "development": { "buildTarget": "inspector:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": { "tsConfig": "tsconfig.spec.json" }
        }
      }
    }
  }
}
